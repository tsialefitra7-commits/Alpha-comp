#!/usr/bin/env python3
"""windres — shim CMake pour zig rc (compilateur de ressources Windows).

CMake (règle Platform/Windows-windres) invoque :
    windres -O coff <DEFINES> <INCLUDES> <FLAGS> <SOURCE> <OBJECT>
et les variantes rc.exe (llvm-rc) utilisent /fo <OBJECT> <SOURCE>.
Les deux syntaxes sont acceptées et traduites vers `zig rc` (compatible
Microsoft Resource Compiler).
"""
import os
import subprocess
import sys

def find_zig():
    for p in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(p, "zig")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return [cand]
    try:
        import ziglang
        return [os.path.join(os.path.dirname(ziglang.__file__), "zig")]
    except Exception:
        pass
    sys.exit("zig introuvable : pip install ziglang")

VALUE_OPTS = {"-O", "-J", "--output-format", "--input-format", "--preprocessor",
              "--preprocessor-arg", "--target", "--codepage", "--include", "-c"}
FLAG_OPTS = {"--use-temp-file", "--no-use-temp-file", "-v", "--verbose",
             "-n", "--null-terminate-strings", "--nostdinc", "-r"}
EXTS = (".rc", ".rcpp", ".obj", ".o", ".res")

def main():
    args = sys.argv[1:]
    defines, includes, positional = [], [], []
    output = None
    i, n = 0, len(args)

    def take(attached=None):
        """Renvoie la valeur (attachée ou argument suivant)."""
        nonlocal i
        if attached:
            i += 1
            return attached
        if i + 1 >= n:
            sys.exit("windres shim : valeur manquante pour " + args[i])
        v = args[i + 1]
        i += 2
        return v

    while i < n:
        a = args[i]
        if a == "--":
            positional.extend(args[i + 1:])
            break
        if a in VALUE_OPTS:
            take()
            continue
        if a in FLAG_OPTS:
            i += 1
            continue
        # sortie
        if a in ("-o", "--output"):
            output = take(); continue
        if a.startswith("--output="):
            output = a.split("=", 1)[1]; i += 1; continue
        if a.startswith("/fo"):
            output = take(a[3:]); continue
        if a.startswith("-o") and len(a) > 2:
            output = a[2:]; i += 1; continue
        # définitions
        if a in ("-D", "-d", "--define", "/d", "/D"):
            defines.append(take()); continue
        if a.startswith("--define="):
            defines.append(a.split("=", 1)[1]); i += 1; continue
        if a[:2] in ("-D", "-d", "/d", "/D") and len(a) > 2:
            defines.append(a[2:]); i += 1; continue
        # includes
        if a in ("-I", "-i", "--include-dir", "/i", "/I"):
            includes.append(take()); continue
        if a.startswith("--include-dir="):
            includes.append(a.split("=", 1)[1]); i += 1; continue
        if a[:2] in ("-I", "-i", "/i", "/I") and len(a) > 2:
            includes.append(a[2:]); i += 1; continue
        # --- options rc.exe restantes (/l, /ln, /c, /sl prennent une valeur) ---
        if a in ("/l", "/ln", "/c", "/sl", "/u"):
            take(); continue
        if a.startswith("/ln") or a.startswith("/sl"):
            i += 1; continue
        if a in ("/v", "/x", "/w", "/y", "/n", "/p", "/h", "/?", "/a", "/r",
                 "/nologo"):
            i += 1; continue
        # autre option « - » : ignorée (avec une éventuelle valeur)
        if a.startswith("-"):
            if i + 1 < n and not args[i + 1].endswith(EXTS):
                take()
            else:
                i += 1
            continue
        # sinon : chemin POSIX (les options rc.exe sont traitées ci-dessus)
        positional.append(a)
        i += 1

    if not positional:
        sys.exit("windres shim : fichier source manquant")
    src = positional[0]
    if output is None and len(positional) > 1:
        output = positional[1]

    cmd = find_zig() + ["rc"]
    for d in defines:
        cmd.append("/d" + d)
    for inc in includes:
        cmd.append("/i" + inc)
    if output:
        cmd.append("/fo" + output)
    cmd.append(src)
    sys.exit(subprocess.call(cmd))

if __name__ == "__main__":
    main()
